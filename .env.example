# Private admin access via a GitHub OAuth app. Keep secrets out of source control.
# Register /auth/github as the callback path on the local or deployed origin.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_GITHUB_REDIRECT_URL=http://localhost:3000/auth/github
# The numeric GitHub user ID, not the username.
NUXT_ADMIN_GITHUB_ID=
NUXT_SESSION_PASSWORD=
# Use the same private value in Convex as CONTENT_SERVICE_TOKEN.
NUXT_CONTENT_SERVICE_TOKEN=
# Optional. Defaults to the existing server-side CONVEX_URL.
NUXT_CONTENT_CONVEX_URL=
NUXT_PUBLIC_SITE_URL=https://sportsync.in

# Set these in the Convex environment, not public Nuxt runtime config:
# CONTENT_SERVICE_TOKEN=<same private value as NUXT_CONTENT_SERVICE_TOKEN>
# OPENROUTER_API_KEY=<your OpenRouter key>
# OPENROUTER_MODEL=openai/gpt-4.1-mini
